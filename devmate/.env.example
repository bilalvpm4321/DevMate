# ---- LLM (get a free key at https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Backend ----
JWT_SECRET=change-me-to-a-long-random-string
DEVMATE_DB=devmate.db
CORS_ORIGINS=http://localhost:5173
# Optional: raises the GitHub API limit from 60 to 5000 requests/hour (public repos only)
GITHUB_TOKEN=

# ---- Community bots ----
BOT_API_KEY=change-me-bot-key
BACKEND_URL=http://localhost:8000
DISCORD_TOKEN=
TELEGRAM_TOKEN=

# ---- OpenRouter Fallback (optional: automatic failover if Gemini limits are hit) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

